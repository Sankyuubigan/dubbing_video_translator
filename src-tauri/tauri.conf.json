{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
"productName": "DeeDub",
  "mainBinaryName": "deedub",
  "version": "26.9.4",
  "identifier": "com.deedub.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
"app": {
    "windows": [
      {
        "title": "DeeDub",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
"plugins": {
    "speech": {
      "default_engine_dir": "D:\\nn\\crispasr",
      "default_models_dir": "D:\\nn\\models\\tts"
    },
    "llama-engine": {
      "data_dir_name": "com.deedub.desktop"
    },
    "logs": {
      "last_logs": true,
      "log_file_name": "deedub.log"
    }
  },
"bundle": {
    "active": false,
    "resources": {
      "redist/*": "redist/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
